# ==============================================================================
# HEIMDALLv2 CONFIGURATION
# ==============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Perception / Model settings
# Options: yolov8n.pt, yolov8s.pt, yolov8m.pt, yolo11n.pt, or path to fine-tuned model
DETECTOR_MODEL=yolov8n.pt
DETECTOR_CONF_THRESHOLD=0.25
DETECTOR_IOU_THRESHOLD=0.50
DETECTOR_IMG_SIZE=640
DETECTOR_DEVICE=auto  # auto, cuda, cpu, mps

# Multi-Object Tracker settings
# Options: botsort, bytetrack
TRACKER_TYPE=botsort
TRACKER_CONFIG=configs/botsort.yaml
TRACKER_ENABLE_REID=false
TRACKER_MATCH_THRESH=0.8
TRACKER_TRACK_BUFFER=60

# Video processing
PROCESS_EVERY_N_FRAMES=1
MAX_TRAJECTORY_HISTORY=100

# Telemetry Provider
# Options: mock, embedded, flytbase
TELEMETRY_PROVIDER=mock

# FlytBase Drone-in-a-Box Integration
# Options: mock, cloud, flytos
FLYTBASE_MODE=mock
FLYTBASE_API_URL=https://api.flytbase.com/v1
FLYTBASE_API_KEY=
FLYTBASE_TOKEN=
FLYTBASE_VEHICLE_ID=VIRTUAL-DRONE-01

# Storage
DATABASE_PATH=outputs/heimdall.db
OUTPUT_DIR=outputs
DATA_DIR=data
